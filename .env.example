# OptiPulse Studio Environment Configuration
# ==========================================
# This project is 100% client-side and performs all image decoding, compression,
# and solver operations locally in the user's browser via Web Workers and OffscreenCanvas.
#
# No remote backend, API keys, database credentials, or server-side secrets are required.
# DO NOT add private credentials or API keys to this file or Vercel environment settings.

# Optional: Custom port for local development (defaults to 5173)
# PORT=5173
